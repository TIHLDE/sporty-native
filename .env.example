# Kopier denne filen til .env og fyll inn ekte verdier.

# Brukes av API-et (Prisma). Verdien under peker på den lokale Docker-databasen (docker-compose.yml).
# ALDRI gi denne prefikset EXPO_PUBLIC_ – slike variabler bakes inn i app-bunten og blir offentlige.
DATABASE_URL="postgresql://sporty:sporty@localhost:5433/sporty"

# Adressen appen bruker for å nå API-et. La stå tom i utvikling: da brukes API-rutene
# på Expo-dev-serveren automatisk. EXPO_PUBLIC_-variabler er synlige i appen.
EXPO_PUBLIC_API_URL=""

# «Logg inn med TIHLDE» (Photon). Klient-ID fra OAuth-klienten på tihlde.org (offentlig klient,
# ingen hemmelighet). EXPO_PUBLIC_ er greit her: klient-ID-en er ikke hemmelig.
EXPO_PUBLIC_PHOTON_CLIENT_ID=""
# Standard er https://photon.tihlde.org. Gjelder både appen og API-et.
# EXPO_PUBLIC_PHOTON_URL="https://photon.tihlde.org"

# Kun i utvikling: lar en innlogget bruker opptre som andre brukere (Profil → Bytt bruker), for å
# teste roller med seed-dataene. ALDRI slå på i produksjon.
ALLOW_DEV_USER_SWITCH="true"

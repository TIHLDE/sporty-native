# Kopier denne filen til .env og fyll inn ekte verdier.

# Adressen appen bruker for å nå API-et (Sporty v3), f.eks. https://sporty.tihlde.org i ferdige
# builds. La stå tom i utvikling: da går forespørslene via Expo-dev-serveren til SPORTY_API_URL.
# EXPO_PUBLIC_-variabler er synlige i appen.
EXPO_PUBLIC_API_URL=""

# «Logg inn med TIHLDE» (Photon). Klient-ID fra OAuth-klienten på tihlde.org (offentlig klient,
# ingen hemmelighet). EXPO_PUBLIC_ er greit her: klient-ID-en er ikke hemmelig.
EXPO_PUBLIC_PHOTON_CLIENT_ID=""
# Standard er https://photon.tihlde.org.
# EXPO_PUBLIC_PHOTON_URL="https://photon.tihlde.org"


# Kun i utvikling: hvor Expo-dev-serveren sender /api-forespørsler (Sporty v3 sin dev-server).
SPORTY_API_URL="http://localhost:3001"
